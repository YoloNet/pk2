<?xml version="1.0" encoding="utf-8"?>
<!--
  PokerKu — ikon cip poker.
  Simbol: cip poker krim dengan takuk emas di keliling, cakera dalam hijau
  felt dan berlian emas di tengah. Dilukis sepenuhnya sebagai vektor —
  TIADA PNG diperlukan (pengajaran dari kuv2: jangan rujuk PNG yang
  tidak wujud dalam repo).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cakera cip (krim) -->
    <path
        android:fillColor="#F7F4EC"
        android:pathData="M54,18 a36,36 0 1,1 -0.1,0 a36,36 0 1,1 0.1,0 z" />

    <!-- Takuk emas di keliling cip (6 takuk, 60 darjah setiap satu) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:fillColor="#C08A1A" android:pathData="M49,18 h10 v9 h-10 z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path android:fillColor="#C08A1A" android:pathData="M49,18 h10 v9 h-10 z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path android:fillColor="#C08A1A" android:pathData="M49,18 h10 v9 h-10 z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:fillColor="#C08A1A" android:pathData="M49,18 h10 v9 h-10 z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="240">
        <path android:fillColor="#C08A1A" android:pathData="M49,18 h10 v9 h-10 z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="300">
        <path android:fillColor="#C08A1A" android:pathData="M49,18 h10 v9 h-10 z" />
    </group>

    <!-- Cakera dalam (hijau felt) -->
    <path
        android:fillColor="#0B3D2E"
        android:pathData="M54,30 a24,24 0 1,1 -0.1,0 a24,24 0 1,1 0.1,0 z" />

    <!-- Gelang emas -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#C08A1A"
        android:strokeWidth="2"
        android:pathData="M54,30 a24,24 0 1,1 -0.1,0 a24,24 0 1,1 0.1,0 z" />

    <!-- Berlian emas di tengah -->
    <path
        android:fillColor="#E7C46A"
        android:pathData="M54,42 L65,54 L54,66 L43,54 z" />
</vector>
